LOAD DATA
APPEND
-- Example fixed-width Oracle EBS lockbox records
INTO TABLE AR_PAYMENTS_INTERFACE
WHEN RECORD_TYPE = '1'
(
 STATUS CONSTANT 'AR_PLB_NEW_RECORD',
 RECORD_TYPE POSITION(1:1) CHAR,
 LOCKBOX_NUMBER POSITION(2:8) CHAR,
 DESTINATION_ACCOUNT POSITION(9:33) CHAR,
 ORIGINATION POSITION(34:43) CHAR,
 DEPOSIT_DATE POSITION(44:49) DATE 'RRMMDD',
 DEPOSIT_TIME POSITION(50:53) CHAR NULLIF DEPOSIT_TIME=BLANKS
)
INTO TABLE AR_PAYMENTS_INTERFACE
WHEN RECORD_TYPE = '5'
(
 RECORD_TYPE POSITION(1:1) CHAR,
 BATCH_NAME POSITION(2:4) CHAR,
 LOCKBOX_NUMBER POSITION(5:11) CHAR,
 DEPOSIT_DATE POSITION(12:17) DATE 'RRMMDD'
)
INTO TABLE AR_PAYMENTS_INTERFACE
WHEN RECORD_TYPE = '6'
(
 RECORD_TYPE POSITION(1:1) CHAR,
 BATCH_NAME POSITION(2:4) CHAR,
 ITEM_NUMBER POSITION(5:7) CHAR,
 REMITTANCE_AMOUNT POSITION(8:17) DECIMAL EXTERNAL,
 TRANSIT_ROUTING_NUMBER POSITION(18:26) CHAR,
 ACCOUNT POSITION(27:36) CHAR,
 CHECK_NUMBER POSITION(37:45) CHAR,
 CUSTOMER_NUMBER POSITION(46:75) CHAR,
 CUSTOMER_REFERENCE1 POSITION(76:105) CHAR
)
INTO TABLE AR_PAYMENTS_INTERFACE
WHEN RECORD_TYPE = '4'
AND ((166:168) != 'STD')
(
 RECORD_TYPE POSITION(1:1) CHAR,
 BATCH_NAME POSITION(2:4) CHAR,
 ITEM_NUMBER POSITION(5:7) CHAR,
 OVERFLOW_INDICATOR POSITION(8:8) CHAR,
 OVERFLOW_SEQUENCE POSITION(9:10) CHAR,
 INVOICE1 POSITION(11:26) CHAR,
 AMOUNT_APPLIED1 POSITION(27:36) DECIMAL EXTERNAL,
 CUSTOMER_REASON1 POSITION(37:66) CHAR NULLIF CUSTOMER_REASON1=BLANKS,
 CUSTOMER_NUMBER POSITION(67:96) CHAR,
 ATTRIBUTE1 POSITION(97:111) CHAR,
 ATTRIBUTE2 POSITION(112:161) CHAR,
 ATTRIBUTE3 POSITION(162:165) CHAR
)
INTO TABLE XXHRC_AR_POC_STG
WHEN RECORD_TYPE = '4'
AND (PROCESS = 'STD')
(
 RECORD_TYPE POSITION(1:1) CHAR,
 BATCH_NAME POSITION(2:4) CHAR,
 ITEM_NUMBER POSITION(5:7) CHAR,
 INVOICE1 POSITION(11:26) CHAR,
 AMOUNT_APPLIED1 POSITION(27:36) DECIMAL EXTERNAL,
 CUSTOMER_NUMBER POSITION(67:96) CHAR,
 PROCESS POSITION(166:175) CHAR
)
INTO TABLE AR_PAYMENTS_INTERFACE
WHEN RECORD_TYPE = '7'
(
 RECORD_TYPE POSITION(1:1) CHAR,
 BATCH_NAME POSITION(2:4) CHAR,
 LOCKBOX_NUMBER POSITION(5:11) CHAR,
 BATCH_RECORD_COUNT POSITION(12:14) CHAR,
 BATCH_AMOUNT POSITION(15:24) DECIMAL EXTERNAL
)
INTO TABLE AR_PAYMENTS_INTERFACE
WHEN RECORD_TYPE = '9'
(
 RECORD_TYPE POSITION(1:1) CHAR,
 LOCKBOX_NUMBER POSITION(2:8) CHAR,
 LOCKBOX_RECORD_COUNT POSITION(9:12) CHAR,
 LOCKBOX_AMOUNT POSITION(13:22) DECIMAL EXTERNAL
)

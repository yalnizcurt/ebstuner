-- Synthetic custom staging layout; not an Oracle-delivered EBS control file.
LOAD DATA
INFILE 'correct.dat'
PRESERVE BLANKS
INTO TABLE XX_NULLS_480
(
  RECORD_TYPE POSITION(1:2) CHAR(2),
  TRANSACTION_ID POSITION(3:12) CHAR(10),
  QUANTITY POSITION(13:16) INTEGER EXTERNAL(4) DEFAULTIF QUANTITY=BLANKS,
  AMOUNT POSITION(17:28) DECIMAL EXTERNAL(12) NULLIF AMOUNT=BLANKS,
  TRANSACTION_DATE POSITION(29:36) DATE "YYYYMMDD" NULLIF TRANSACTION_DATE=BLANKS,
  RESERVED FILLER POSITION(37:56) CHAR(20),
  COMMENTS POSITION(57:480) CHAR(424),
  STATUS CONSTANT 'NEW'
)

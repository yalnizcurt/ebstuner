-- Synthetic custom staging layout; not an Oracle-delivered EBS control file.
LOAD DATA
INFILE 'correct.dat'
INTO TABLE XX_MIXED_80
(
  RECORD_TYPE POSITION(1:2) CHAR(2),
  TRANSACTION_ID POSITION(3:12) CHAR(10),
  QUANTITY POSITION(13:16) INTEGER EXTERNAL(4),
  AMOUNT POSITION(17:28) DECIMAL EXTERNAL(12),
  TRANSACTION_DATE POSITION(29:36) DATE "YYYYMMDD",
  COMMENTS POSITION(37:80) CHAR(44)
)

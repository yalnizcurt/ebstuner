-- Synthetic custom staging layout; not an Oracle-delivered EBS control file.
LOAD DATA
INFILE 'correct.dat'
INTO TABLE XX_RELATIVE_240
(
  RECORD_TYPE POSITION(*) CHAR(2),
  TRANSACTION_ID POSITION(*) CHAR(10),
  QUANTITY POSITION(*) INTEGER EXTERNAL(4),
  RATE POSITION(*) FLOAT EXTERNAL(12),
  TRANSACTION_DATE POSITION(*) DATE "YYYYMMDD",
  COMMENTS POSITION(37:240) CHAR(204)
)

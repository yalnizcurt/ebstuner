-- Synthetic custom staging layout; not an Oracle-delivered EBS control file.
LOAD DATA
INFILE 'correct.dat'
INTO TABLE XX_AR_RECEIPT_2400
(
  RECORD_TYPE POSITION(1:2) CHAR(2),
  BATCH_NAME POSITION(3:12) CHAR(10),
  ITEM_NUMBER POSITION(13:18) CHAR(6),
  CUSTOMER_NUMBER POSITION(19:30) CHAR(12),
  RECEIPT_NUMBER POSITION(31:50) CHAR(20),
  CURRENCY_CODE POSITION(51:53) CHAR(3),
  REMITTANCE_AMOUNT POSITION(54:67) DECIMAL EXTERNAL(14) NULLIF REMITTANCE_AMOUNT=BLANKS,
  DEPOSIT_DATE POSITION(68:75) DATE "YYYYMMDD" NULLIF DEPOSIT_DATE=BLANKS,
  ATTRIBUTE1 POSITION(76:195) CHAR(120),
  ATTRIBUTE2 POSITION(196:315) CHAR(120),
  ATTRIBUTE3 POSITION(316:435) CHAR(120),
  ATTRIBUTE4 POSITION(436:555) CHAR(120),
  ATTRIBUTE5 POSITION(556:675) CHAR(120),
  ATTRIBUTE6 POSITION(676:795) CHAR(120),
  ATTRIBUTE7 POSITION(796:915) CHAR(120),
  ATTRIBUTE8 POSITION(916:1035) CHAR(120),
  ATTRIBUTE9 POSITION(1036:1155) CHAR(120),
  ATTRIBUTE10 POSITION(1156:1275) CHAR(120),
  ATTRIBUTE11 POSITION(1276:1395) CHAR(120),
  ATTRIBUTE12 POSITION(1396:1515) CHAR(120),
  ATTRIBUTE13 POSITION(1516:1635) CHAR(120),
  ATTRIBUTE14 POSITION(1636:1755) CHAR(120),
  ATTRIBUTE15 POSITION(1756:1875) CHAR(120),
  COMMENTS POSITION(1876:2400) CHAR(525)
)
